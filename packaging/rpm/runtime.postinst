#!/bin/sh
set -eu

# Creation de l'utilisateur abls-agent-server
if ! getent passwd abls-agent-server >/dev/null 2>&1; then
  useradd --system --gid abls --no-create-home --shell /sbin/nologin abls-agent-server || true
fi

# Creation du repertoire de travail
mkdir -p /var/lib/abls-agent-server
chown abls-agent-server:abls /var/lib/abls-agent-server
chmod 750 /var/lib/abls-agent-server

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
